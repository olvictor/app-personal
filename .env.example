# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Painel do Supabase > Project Settings > API

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Deve ser igual ao DOMINIO_INTERNO da função criar-acesso.
# Não é um e-mail de verdade: serve só para o celular virar identificador.
VITE_DOMINIO_INTERNO=alunos.prancheta.local
